{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "g++ 构建 Anime_Archive_Z",
      "type": "shell",
      "command": "D:/Tool/VSCode/mingw64/bin/g++.exe",
      "args": [
        "-finput-charset=UTF-8",
        "-fexec-charset=UTF-8",
        "-fdiagnostics-color=always",
        "-g",
        "-I${workspaceFolder}/include",
        "${workspaceFolder}/src/main.cpp",
        "${workspaceFolder}/src/Anime.cpp",
        "${workspaceFolder}/src/AnimeStore.cpp",
        "${workspaceFolder}/src/UI.cpp",
        "-o",
        "${workspaceFolder}/Anime_Archive_Z.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [ "$gcc" ],
      "detail": "显式列出源文件，输出到仓库根（*.exe 已被 gitignore）"
    }
  ]
}